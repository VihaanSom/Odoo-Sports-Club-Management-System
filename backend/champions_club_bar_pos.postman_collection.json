{
  "info": {
    "_postman_id": "champions-club-bar-pos-collection",
    "name": "Champions Club — Bar & POS Module (MI-01 to TB-05)",
    "description": "Production-grade Postman collection for testing Menu Items, Bar Tables, and Bar Tabs POS lifecycle.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "barStaffToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "menuItemId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "barTableId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "tabId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Login as Admin / Bar Staff",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('adminToken', jsonData.data.accessToken);",
              "    pm.collectionVariables.set('barStaffToken', jsonData.data.accessToken);",
              "    console.log('Saved token:', jsonData.data.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@championsclub.com\",\n  \"password\": \"Admin@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "1. MI-01: List Menu Items",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{barStaffToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/menu-items?page=1&pageSize=20&isAvailable=true",
          "host": ["{{baseUrl}}"],
          "path": ["menu-items"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "pageSize", "value": "20" },
            { "key": "isAvailable", "value": "true" }
          ]
        }
      }
    },
    {
      "name": "2. MI-02: Create Menu Item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('menuItemId', jsonData.data.id);",
              "    console.log('Saved menuItemId:', jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Club Triple Decker Sandwich\",\n  \"category\": \"food\",\n  \"description\": \"Toasted multi-grain bread with chicken and herbs\",\n  \"pricePaise\": 35000,\n  \"stockQty\": 40,\n  \"lowStockThreshold\": 5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/menu-items",
          "host": ["{{baseUrl}}"],
          "path": ["menu-items"]
        }
      }
    },
    {
      "name": "3. MI-03: Get Menu Item Details",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{barStaffToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/menu-items/{{menuItemId}}",
          "host": ["{{baseUrl}}"],
          "path": ["menu-items", "{{menuItemId}}"]
        }
      }
    },
    {
      "name": "4. MI-04: Update Menu Item",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"pricePaise\": 38000,\n  \"stockQty\": 45\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/menu-items/{{menuItemId}}",
          "host": ["{{baseUrl}}"],
          "path": ["menu-items", "{{menuItemId}}"]
        }
      }
    },
    {
      "name": "5. BT-01: List Bar Tables with Live Occupancy",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{barStaffToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/bar/tables",
          "host": ["{{baseUrl}}"],
          "path": ["bar", "tables"]
        }
      }
    },
    {
      "name": "6. BT-02: Create Bar Table",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('barTableId', jsonData.data.id);",
              "    console.log('Saved barTableId:', jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tableNo\": \"T99\",\n  \"capacity\": 6\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bar/tables",
          "host": ["{{baseUrl}}"],
          "path": ["bar", "tables"]
        }
      }
    },
    {
      "name": "7. BT-03: Update Bar Table",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{adminToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"capacity\": 8\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bar/tables/{{barTableId}}",
          "host": ["{{baseUrl}}"],
          "path": ["bar", "tables", "{{barTableId}}"]
        }
      }
    },
    {
      "name": "8. TB-01: List Open Bar Tabs",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{barStaffToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/bar/tabs?status=open",
          "host": ["{{baseUrl}}"],
          "path": ["bar", "tabs"],
          "query": [
            { "key": "status", "value": "open" }
          ]
        }
      }
    },
    {
      "name": "9. TB-02: Open Bar Tab",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('tabId', jsonData.data.id);",
              "    console.log('Saved tabId:', jsonData.data.id);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{barStaffToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"barTableId\": 1,\n  \"memberId\": 1,\n  \"notes\": \"Gold Member Birthday celebration\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bar/tabs",
          "host": ["{{baseUrl}}"],
          "path": ["bar", "tabs"]
        }
      }
    },
    {
      "name": "10. TB-03: Get Tab Detail",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{barStaffToken}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/bar/tabs/{{tabId}}",
          "host": ["{{baseUrl}}"],
          "path": ["bar", "tabs", "{{tabId}}"]
        }
      }
    },
    {
      "name": "11. TB-04: Add Items to Tab (ACID & WebSocket)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{barStaffToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"items\": [\n    { \"menuItemId\": {{menuItemId}}, \"qty\": 2 }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bar/tabs/{{tabId}}/items",
          "host": ["{{baseUrl}}"],
          "path": ["bar", "tabs", "{{tabId}}", "items"]
        }
      }
    },
    {
      "name": "12. TB-05: Settle Bar Tab with Payment",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{barStaffToken}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"paymentMethod\": \"card\",\n  \"referenceNo\": \"POS-TXN-2026-9876\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bar/tabs/{{tabId}}/settle",
          "host": ["{{baseUrl}}"],
          "path": ["bar", "tabs", "{{tabId}}", "settle"]
        }
      }
    }
  ]
}
