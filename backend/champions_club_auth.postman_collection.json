{
  "info": {
    "_postman_id": "champions-club-auth-collection",
    "name": "Champions Club — Auth Module (AU-01 to AU-04)",
    "description": "Production-grade Postman collection for testing Champions Club Authentication endpoints with automated token capture.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login — Active Gold Member (Rahul)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
              "    console.log('Saved accessToken to collection variable:', jsonData.data.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"rahul.gold@championsclub.com\",\n  \"password\": \"Member@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "description": "Logs in active Gold member. Captures JWT accessToken into collection variable and stores httpOnly refreshToken in Postman cookie jar."
      }
    },
    {
      "name": "2. Login — Admin Staff",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
              "    console.log('Saved Admin accessToken:', jsonData.data.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@championsclub.com\",\n  \"password\": \"Admin@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "description": "Logs in Club Admin. Returns staff payload (tier is null, role is admin)."
      }
    },
    {
      "name": "3. Login — Front Desk Staff (Aarav)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"frontdesk@championsclub.com\",\n  \"password\": \"Staff@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "4. Login — Expired Member (Expect 403)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"expired.member@championsclub.com\",\n  \"password\": \"Member@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "description": "Tests edge case: membership status is expired. Expected 403 Forbidden with code ACCOUNT_INACTIVE."
      }
    },
    {
      "name": "5. Login — Inactive Staff (Expect 403)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"inactive.staff@championsclub.com\",\n  \"password\": \"Staff@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "description": "Tests edge case: staff isActive is false. Expected 403 Forbidden with code ACCOUNT_INACTIVE."
      }
    },
    {
      "name": "6. Login — Wrong Password (Expect 401)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"rahul.gold@championsclub.com\",\n  \"password\": \"WrongPass123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "description": "Tests edge case: password mismatch. Expected 401 Unauthorized with code INVALID_CREDENTIALS."
      }
    },
    {
      "name": "7. Login — Validation Failure (Expect 400)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"invalid-email-address\",\n  \"password\": \"123\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "login"]
        },
        "description": "Tests Zod validation schema. Expected 400 Bad Request with code VALIDATION_ERROR."
      }
    },
    {
      "name": "8. Get Profile (/auth/me) — Authenticated",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/me",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "me"]
        },
        "description": "AU-04: Returns current user profile using the accessToken saved from the login request."
      }
    },
    {
      "name": "9. Refresh Token (/auth/refresh)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.collectionVariables.set('accessToken', jsonData.data.accessToken);",
              "    console.log('Rotated new accessToken:', jsonData.data.accessToken);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/auth/refresh",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "refresh"]
        },
        "description": "AU-02: Uses the refreshToken httpOnly cookie in Postman's cookie jar to generate a new 15-minute access token and rotate the cookie."
      }
    },
    {
      "name": "10. Logout (/auth/logout)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/auth/logout",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "logout"]
        },
        "description": "AU-03: Invalidates the session and clears the refreshToken cookie."
      }
    }
  ]
}
